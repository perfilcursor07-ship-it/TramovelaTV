NODE_ENV=development
PORT=3333
# URL do front (usada em links e CORS)
APP_URL=http://localhost:5173
# URL pública da API (precisa ser HTTPS para o PagBank enviar webhook)
PUBLIC_API_URL=http://localhost:3333

JWT_SECRET=troque-isto
STREAM_SECRET=troque-isto-tambem
# Validade (minutos) do link temporário do vídeo
STREAM_TOKEN_MINUTES=180

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tramovelatv

# PagBank: mock | sandbox | production
#  mock = gera QR falso local e permite "simular pagamento" (para desenvolvimento)
PAGBANK_ENV=mock
PAGBANK_TOKEN_SANDBOX=
PAGBANK_TOKEN_PRODUCTION=
PIX_EXPIRATION_MINUTES=30

MAX_VIDEO_SIZE_MB=2048

# Admin criado pelo seed (npm run seed)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@novelas.local
SEED_ADMIN_PASSWORD=troque-esta-senha
